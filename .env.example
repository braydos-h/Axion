# Axion runtime environment overrides.
# Prefer /etc/axion/axion.toml for persistent configuration.

# Configuration path used by the CLI when --config is omitted.
AXION_CONFIG=/etc/axion/axion.toml

# Optional management API overrides. A token is mandatory for non-loopback binds.
AXION_API_BIND=127.0.0.1:8787
AXION_API_TOKEN=

# Default capture interface (CLI --interface overrides this).
AXION_INTERFACE=eth0

# Rust log filter; config.general.log_level is used when this is unset.
RUST_LOG=info
